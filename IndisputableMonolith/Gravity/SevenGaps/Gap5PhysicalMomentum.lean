/-! ## §0. Inventory: no prior posting-grounded definition

The Gap5 chain modules (`Gap5ChartFromLedgerMomentum`,
`Gap5MomentumAdditivity`, `Gap5MomentumMagnitudeBridge`,
`Gap5EnergyEqualsCostDerivation`, `Gap5MomentumAdditivityComposition`,
`Gap5NetImbalanceDerivation`) all quantify over an abstract
`p : LedgerState → ℝ`. The chart carrier supplies `imbalance` as a *candidate*
linear functional, not as a declared physical-momentum definition. The Gap2
posting-dynamics modules define incidence/counts on posting alphabets, not a
chart-level momentum observable. This module supplies the missing definition.
-/

/-! ## §1. MODEL definition: physical momentum is net charge -/

/-- **Physical momentum (FOUNDATIONAL MODEL, adopted by Jon 2026-07-31,
`D-qg-eec-adopted-as-model-20260731`).** The signed net charge of a
double-entry ledger state: debit column minus credit column. Posting-grounded:
every posting contributes to exactly these two columns, and the momentum
generated by the posting layer is their signed difference. Equal by definition
to the library `imbalance`.

Adopted as a foundational MODEL, not derived: the wall theorem
`MomentumBridge.bridge_not_forced_by_scale_free_package` shows that no
conjunction of scale-free selection properties forces the momentum scale, so
the identification is an adoption, and the conversion-theorem lane (deriving
the scale from posting dynamics) stays OPEN frontier. The conditional-chain
assembly that discharges the bridge hypotheses against this identification
lives in `Gap5MomentumModelAssembly`. -/
def physicalMomentum : LedgerState → ℝ := imbalance

theorem physicalMomentum_eq_imbalance :
    physicalMomentum = imbalance := rfl

theorem physicalMomentum_def (z : LedgerState) :
    physicalMomentum z = z.1 - z.2 := rfl

/-! ## §2. (O1) Posting incidence from the net-charge definition -/

/-- **(O1).** Column posting incidence holds for the physical momentum because
net charge splits over the two axes: `d - c = (d - 0) + (0 - c)`. No abstract
incidence hypothesis: the property is a theorem about the definition. -/
theorem physicalMomentum_posting_incidence :
    PostingIncidence physicalMomentum := by
  intro d c
  change d - c = (d - 0) + (0 - c)
  ring

/-! ## §3. (O2) Debit-axis Cauchy from consolidation of net charges -/

/-- On the pure-debit axis the physical momentum is the identity: a pure-debit
state of charge `m` has net charge `m`. -/
theorem physicalMomentum_on_debit_axis (m : ℝ) :
    physicalMomentum (m, 0) = m := by
  change m - 0 = m
  ring

/-- **(O2).** Debit-axis additivity: consolidating two pure-debit net charges
adds the counts. Immediate from the identity reading on the debit axis. -/
theorem physicalMomentum_additiveOnDebitAxis :
    AdditiveOnDebitAxis physicalMomentum := by
  intro m n
  rw [physicalMomentum_on_debit_axis m, physicalMomentum_on_debit_axis n,
    physicalMomentum_on_debit_axis (m + n)]

/-- Net-imbalance reading is immediate: the momentum *is* the net charge. -/
theorem physicalMomentum_readsNetImbalance :
    ReadsNetImbalance physicalMomentum := by
  intro z
  change z.1 - z.2 = (z.1 - z.2) - 0
  ring

theorem physicalMomentum_swap_odd : SwapOdd physicalMomentum := by
  intro z
  change z.2 - z.1 = -(z.1 - z.2)
  ring

theorem physicalMomentum_continuous : Continuous physicalMomentum :=
  continuous_imbalance

theorem physicalMomentum_unit :
    physicalMomentum (1, 0) ^ 2 = 1 := by
  change ((1 : ℝ) - 0) ^ 2 = 1
  norm_num

theorem physicalMomentum_balance_vanishing :
    ∀ z : LedgerState, Balanced z → physicalMomentum z = 0 := by
  intro z hz
  change z.1 - z.2 = 0
  exact sub_eq_zero.mpr hz

theorem physicalMomentum_additive :
    ∀ z w : LedgerState,
      physicalMomentum (z + w) = physicalMomentum z + physicalMomentum w := by
  intro z w
  change (z.1 + w.1) - (z.2 + w.2) = (z.1 - z.2) + (w.1 - w.2)
  ring

/-! ## §4. End-to-end composition: EnergyEqualsCost for the defined p -/

/-- **End-to-end discharge.** For the posting-grounded physical momentum, O1,
O2, continuity, and unit are all theorems (no remaining hypotheses). The
upstream consumer therefore yields full consolidation additivity,
balance-vanishing, and `EnergyEqualsCost`. -/
theorem energyEqualsCost_of_physicalMomentum :
    (∀ z w : LedgerState,
      physicalMomentum (z + w) =
        physicalMomentum z + physicalMomentum w) ∧
      (∀ z : LedgerState, Balanced z → physicalMomentum z = 0) ∧
      EnergyEqualsCost physicalMomentum :=
  energyEqualsCost_of_posting_incidence_additive_unit
    physicalMomentum
    physicalMomentum_posting_incidence
    physicalMomentum_swap_odd
    physicalMomentum_additiveOnDebitAxis
    physicalMomentum_continuous
    physicalMomentum_unit

/-- Direct inhabitation of the full posting package (no hypotheses). -/
theorem physicalMomentum_inhabits_posting_package :
    PostingIncidence physicalMomentum ∧
      SwapOdd physicalMomentum ∧
      ReadsNetImbalance physicalMomentum ∧
      AdditiveOnDebitAxis physicalMomentum ∧
      Continuous physicalMomentum ∧
      physicalMomentum ((1, 0) : LedgerState) ^ 2 = 1 ∧
      EnergyEqualsCost physicalMomentum :=
  ⟨physicalMomentum_posting_incidence, physicalMomentum_swap_odd,
    physicalMomentum_readsNetImbalance, physicalMomentum_additiveOnDebitAxis,
    physicalMomentum_continuous, physicalMomentum_unit,
    (energyEqualsCost_of_physicalMomentum).2.2⟩

/-! ## §5. Selection among column-separable observables (scoped witness)

`cubeDiff` from the prior module is continuous, swap-odd, balance-vanishing,
unit-normalized, and column-incident, yet fails O2. It is a function of the
ledger columns but is **not** the net-charge reading. Quantifier first: this
is a concrete package witness on the stated `LedgerState` carrier, not a class
theorem over posting systems (`L-qg-witness-is-not-a-class-20260729`). The
MODEL definition selects the net-charge reading among column-separable
candidates; without that selection, O2 is not forced.
-/

theorem cubeDiff_is_not_physicalMomentum :
    cubeDiff ≠ physicalMomentum := by
  intro h
  have h1 := congrFun h ((2, 1) : LedgerState)
  -- cubeDiff (2,1) = 8 - 1 = 7; physicalMomentum (2,1) = 1
  change (2 : ℝ) ^ 3 - (1 : ℝ) ^ 3 = (2 : ℝ) - 1 at h1
  norm_num at h1

theorem net_charge_selected_among_incident :
    PostingIncidence physicalMomentum ∧
      AdditiveOnDebitAxis physicalMomentum ∧
      PostingIncidence cubeDiff ∧
      ¬ AdditiveOnDebitAxis cubeDiff ∧
      cubeDiff ≠ physicalMomentum :=
  ⟨physicalMomentum_posting_incidence, physicalMomentum_additiveOnDebitAxis,
    cubeDiff_posting_incidence, cubeDiff_not_additiveOnDebitAxis,
    cubeDiff_is_not_physicalMomentum⟩

/-! ## §6. Certificate -/

/-- **Physical-momentum MODEL verdict.** (c): `physicalMomentum` is defined as
the net charge of the double-entry ledger state; O1 and O2 are theorems about
that definition; the EnergyEqualsCost consumer fires with no remaining
hypotheses. Supporting selection witness: `cubeDiff` shares column incidence
and fails O2, so the net-charge identification is load-bearing. -/
structure PhysicalMomentumVerdict : Prop where
  definition_eq_imbalance : physicalMomentum = imbalance
  o1_posting_incidence : PostingIncidence physicalMomentum
  o2_debit_axis_cauchy : AdditiveOnDebitAxis physicalMomentum
  reads_net : ReadsNetImbalance physicalMomentum
  swap_odd : SwapOdd physicalMomentum
  continuous : Continuous physicalMomentum
  unit : physicalMomentum ((1, 0) : LedgerState) ^ 2 = 1
  end_to_end_energy_equals_cost :
    (∀ z w : LedgerState,
      physicalMomentum (z + w) =
        physicalMomentum z + physicalMomentum w) ∧
      (∀ z : LedgerState, Balanced z → physicalMomentum z = 0) ∧
      EnergyEqualsCost physicalMomentum
  selection_among_incident :
    PostingIncidence physicalMomentum ∧
      AdditiveOnDebitAxis physicalMomentum ∧
      PostingIncidence cubeDiff ∧
      ¬ AdditiveOnDebitAxis cubeDiff ∧
      cubeDiff ≠ physicalMomentum

theorem physicalMomentumVerdict : PhysicalMomentumVerdict where
  definition_eq_imbalance := physicalMomentum_eq_imbalance
  o1_posting_incidence := physicalMomentum_posting_incidence
  o2_debit_axis_cauchy := physicalMomentum_additiveOnDebitAxis
  reads_net := physicalMomentum_readsNetImbalance
  swap_odd := physicalMomentum_swap_odd
  continuous := physicalMomentum_continuous
  unit := physicalMomentum_unit
  end_to_end_energy_equals_cost := energyEqualsCost_of_physicalMomentum
  selection_among_incident := net_charge_selected_among_incident

