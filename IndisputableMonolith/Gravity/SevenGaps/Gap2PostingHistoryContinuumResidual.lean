/-! ## §1. Posting-history continuum data -/

/-- Finite posting-history carrier with mass pushforward onto exact path
classes. The fields `generatedByActualPostingTransaction` and
`historyGaugeInvariant` are substantive Prop slots: inhabiting them is
the attachment work of a later session, not a `True`-shell. -/
structure PostingHistoryContinuumData where
  History : ℕ → Type
  instFintype : ∀ n, Fintype (History n)
  forget : ∀ {n}, History n → ExactPathClass n
  phase : ∀ {n}, History n → Fin 8
  mu : ∀ {n}, History n → ℝ
  /-- Histories are generated by an actual period-8 recognition posting
  transaction (not an external Fin-8 glue on classes). -/
  generatedByActualPostingTransaction : Prop
  /-- History labels / masses are gauge-invariant under the history
  equivalence appropriate to the posting substrate. -/
  historyGaugeInvariant : Prop
  mu_nonnegative : ∀ n (h : History n), 0 ≤ mu h
  /-- Pushforward of history mass recovers Burnside class mass. -/
  pushforward_mu :
    ∀ n (c : ExactPathClass n),
      (∑ h ∈ @Finset.univ (History n) (instFintype n),
        if forget h = c then mu h else (0 : ℝ)) = classMu c

/-- History-level shell amplitude: mass-weighted 8th-root character sum. -/
def postingHistoryShellAmplitude (P : PostingHistoryContinuumData) (n : ℕ) :
    ℂ :=
  ∑ h ∈ @Finset.univ (P.History n) (P.instFintype n),
    (P.mu h : ℂ) * tickRoot (P.phase h)

/-! ## §2. Character bridge to exact-path classes -/

/-- Provenance: the class-level tick is forced by the posting phase on
histories that forget to that class. -/
def PostingTransactionForcedExactTick (P : PostingHistoryContinuumData)
    (tau : ∀ n, ExactPathClass n → Fin 8) : Prop :=
  ∀ n (h : P.History n), P.phase h = tau n (P.forget h)

/-- Bridge from history continuum data to a class-level Fin-8 tick with
character pushforward and decoy escape. Uninhabited in this module. -/
structure PostingHistoryExactCharacterBridge
    (P : PostingHistoryContinuumData) where
  tau : ∀ n, ExactPathClass n → Fin 8
  /-- Fiberwise history character amplitude equals
  `classMu c * tickRoot (tau n c)`. -/
  character_pushforward :
    ∀ n (c : ExactPathClass n),
      (∑ h ∈ @Finset.univ (P.History n) (P.instFintype n),
          if P.forget h = c then (P.mu h : ℂ) * tickRoot (P.phase h)
          else (0 : ℂ)) =
        (classMu c : ℂ) * tickRoot (tau n c)
  provenance : PostingTransactionForcedExactTick P tau
  not_shellSig : ¬ ShellSigTick tau

/-- Discharge helper (named obligation): forced posting tick plus mass
pushforward imply the bridge `character_pushforward` field. Banked as a
Prop so later sessions can prove it without widening this API surface;
not inhabited here. -/
def CharacterPushforwardOfForcedObligation
    (P : PostingHistoryContinuumData)
    (tau : ∀ n, ExactPathClass n → Fin 8) : Prop :=
  PostingTransactionForcedExactTick P tau →
    ∀ n (c : ExactPathClass n),
      (∑ h ∈ @Finset.univ (P.History n) (P.instFintype n),
          if P.forget h = c then (P.mu h : ℂ) * tickRoot (P.phase h)
          else (0 : ℂ)) =
        (classMu c : ℂ) * tickRoot (tau n c)

/-- Packaging note: given `PostingHistoryExactCharacterBridge P`, the
identity
`postingHistoryShellAmplitude P n = exactShellAmplitude (tickDerivedPhase B.tau) n`
follows from fiber partition plus `character_pushforward`. Left as an
inhabitation obligation for a later session (not required to bank the
OPEN residuals). -/
def postingHistoryAmplitudeMatchesExactShell
    (P : PostingHistoryContinuumData)
    (B : PostingHistoryExactCharacterBridge P) : Prop :=
  ∀ n : ℕ,
    postingHistoryShellAmplitude P n =
      exactShellAmplitude (tickDerivedPhase B.tau) n

