    ∃ (F : ClosedFramework.ClosedObservableFramework) (base : F.S),
      (¬ (∀ k,
        F.r (F.T^[k + 2] base) / F.r (F.T^[k + 1] base) =
          F.r (F.T^[k + 1] base) / F.r (F.T^[k] base))) ∧
      (¬ (F.r (F.T^[2] base) = F.r (F.T^[1] base) + F.r base))
  rightAffine_obstruction :
    ∃ P : ℝ → ℝ → ℝ,
      (∀ u v, P u v = P v u) ∧
      (∀ u, P u 0 = 2 * u) ∧
      P 1 1 = 6 ∧
      ¬ (∀ u, ∃ α β, ∀ v, P u v = α * v + β)
  positiveRatio_obstruction :
    ¬ Nonempty (PositiveRatioBridgeStrict.LogPositiveRatioCoordinates
      (K := Bool) ⟨false, true, Bool.noConfusion⟩)
