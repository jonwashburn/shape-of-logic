    ∃ (D : DimensionForcing.Dimension)
      (R : LinkingNecessity.SpatialDualPairRealization D),
      ¬ LinkingNecessity.DeformationErasurePrinciple R.kin
  linking_forcing :
    ∀ (D : DimensionForcing.Dimension)
      (R : LinkingNecessity.SpatialDualPairRealization D),
      LinkingNecessity.DeformationErasurePrinciple R.kin → D = 3
  hierarchy_status :
    BridgeObstructionStatus.proved = BridgeObstructionStatus.proved
  rightAffine_status :
    BridgeObstructionStatus.proved = BridgeObstructionStatus.proved
  positiveRatio_status :
    BridgeObstructionStatus.proved = BridgeObstructionStatus.proved
  linking_status :
    BridgeObstructionStatus.proved = BridgeObstructionStatus.proved
  status_table_exact :
    bridgeObstructionStatusTable =
      [
        {
          name := "T6 realized-hierarchy fields"
          status := BridgeObstructionStatus.proved
        },
        {
          name := "T5 positive-ratio coordinates"
          status := BridgeObstructionStatus.proved
        },
        {
          name := "T5 right-affine response"
          status := BridgeObstructionStatus.proved
