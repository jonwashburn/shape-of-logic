theorem bridgeObstructionStatusTable_proved_count :
    (bridgeObstructionStatusTable.filter
      fun e => e.status == BridgeObstructionStatus.proved).length = 4 :=
  rfl

/-- No bridge-obstruction row remains a bare documented bridge definition. -/
theorem bridgeObstructionStatusTable_documented_count :
    (bridgeObstructionStatusTable.filter
      fun e => e.status == BridgeObstructionStatus.documentedBridgeDefinition).length = 0 :=
  rfl

/-- Every non-linking bridge row has a proved obstruction. -/
theorem non_linking_bridge_obstructions_proved :
    ∀ e ∈ bridgeObstructionStatusTable,
      e.name ≠ "T8 linking interpretation" →
        e.status = BridgeObstructionStatus.proved := by
  intro e he _hname
  simp [bridgeObstructionStatusTable] at he
  rcases he with he | he | he | he <;> (subst e; rfl)

/-- The linking bridge row now carries a proved obstruction. -/
theorem linking_bridge_status_proved :
    ∃ e ∈ bridgeObstructionStatusTable,
      e.name = "T8 linking interpretation" ∧
        e.status = BridgeObstructionStatus.proved := by
  refine ⟨{
    name := "T8 linking interpretation"
    status := BridgeObstructionStatus.proved
  }, ?_, rfl, rfl⟩
  simp [bridgeObstructionStatusTable]

/-- Every bridge row has a proved obstruction. -/
theorem all_bridge_obstructions_proved :
    ∀ e ∈ bridgeObstructionStatusTable,
      e.status = BridgeObstructionStatus.proved := by
  intro e he
  simp [bridgeObstructionStatusTable] at he
  rcases he with he | he | he | he <;> (subst e; rfl)

