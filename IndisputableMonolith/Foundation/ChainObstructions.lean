/-!
# Chain Obstructions

Forward bridges are only convincing when paired with independence checks.  This
module gathers the proved obstructions for the T6 hierarchy bridge, the
positive-ratio bridge, the RCL gate's `rightAffine` field, and (since the
`LinkingNecessity` closure) the T8 linking interpretation.

The linking row was historically a `documentedBridgeDefinition`: the linking
requirement was asserted by definition with no independence check.
`LinkingNecessity` factored that bridge into the named
`DeformationErasurePrinciple` plus theorems (the principle forces `D = 3`;
off `D = 3` the dual-pair distinction is provably erasable) plus the proved
obstruction recorded here (`linking_interpretation_obstruction`): the
spatial-realization layer alone does not force the principle, so it is a
genuine named input, exactly parallel to the other three rows.
-/

namespace IndisputableMonolith
namespace Foundation
namespace ChainObstructions

open ForcingStatus

/-! ## T6 hierarchy obstruction -/

/-- Existing obstruction: a closed observable framework alone does not force the
two realized-hierarchy fields needed by the T5-to-T6 bridge. -/
theorem hierarchy_fields_obstruction :
    ∃ (F : ClosedFramework.ClosedObservableFramework) (base : F.S),
      (¬ (∀ k,
        F.r (F.T^[k + 2] base) / F.r (F.T^[k + 1] base) =
          F.r (F.T^[k + 1] base) / F.r (F.T^[k] base))) ∧
      (¬ (F.r (F.T^[2] base) = F.r (F.T^[1] base) + F.r base)) :=
  HierarchyRealizationObstruction.closedFramework_does_not_force_realizedHierarchy_fields

/-! ## Positive-ratio bridge obstruction -/

/-- Existing obstruction: the Boolean floor generated by one distinction cannot
carry injective log-coordinate positive-ratio coordinates.  The analytic
positive-ratio layer is therefore not already present inside the finite
two-class quotient. -/
theorem positiveRatio_coordinates_obstruction :
    ¬ Nonempty (PositiveRatioBridgeStrict.LogPositiveRatioCoordinates
      (K := Bool) ⟨false, true, Bool.noConfusion⟩) :=
  PositiveRatioBridgeStrict.bool_floor_no_log_positive_ratio_coordinates

/-! ## RCL gate obstruction -/

/-- A symmetric combiner satisfying the zero-boundary and unit-diagonal
conditions, but deliberately nonlinear in the second argument. -/
def nonRightAffineCombiner (u v : ℝ) : ℝ :=
  3 * u * v + 2 * u + 2 * v - u^2 * v^2

theorem nonRightAffineCombiner_symmetric :
    ∀ u v, nonRightAffineCombiner u v = nonRightAffineCombiner v u := by
  intro u v
  unfold nonRightAffineCombiner
  ring

theorem nonRightAffineCombiner_zeroBoundary :
    ∀ u, nonRightAffineCombiner u 0 = 2 * u := by
  intro u
  unfold nonRightAffineCombiner
  ring

theorem nonRightAffineCombiner_unitDiagonal :
    nonRightAffineCombiner 1 1 = 6 := by
  unfold nonRightAffineCombiner
  norm_num

/-- Boundary, symmetry, and unit normalization do not force the affine-response
field used by `FactorizationAssociativityGate`.  The missing `rightAffine`
field is therefore a real structural input, not a consequence of the other gate
fields. -/
theorem boundary_symmetry_unit_do_not_force_rightAffine :
    ∃ P : ℝ → ℝ → ℝ,
      (∀ u v, P u v = P v u) ∧
      (∀ u, P u 0 = 2 * u) ∧
      P 1 1 = 6 ∧
      ¬ (∀ u, ∃ α β, ∀ v, P u v = α * v + β) := by
  refine ⟨nonRightAffineCombiner, nonRightAffineCombiner_symmetric,
    nonRightAffineCombiner_zeroBoundary, nonRightAffineCombiner_unitDiagonal, ?_⟩
  intro hAffine
  obtain ⟨α, β, hline⟩ := hAffine 1
  have h0 : β = 2 := by
    have h := hline 0
    unfold nonRightAffineCombiner at h
    linarith
  have h1 : α + β = 6 := by
    have h := hline 1
    unfold nonRightAffineCombiner at h
    linarith
  have hα : α = 4 := by
    linarith
  have h2 : 8 = 2 * α + β := by
    have h := hline 2
    unfold nonRightAffineCombiner at h
    norm_num at h
    linarith
  linarith

/-! ## T8 linking-interpretation obstruction and forcing -/

/-- **Linking-interpretation obstruction (proved).**  The spatial-realization
layer alone does not force the deformation-erasure principle: a complete
spatial dual-pair realization exists (in `D = 4`, on the everything-deforms
kinematics) in which every pairing observable vanishes and the principle
fails.  The principle is therefore a genuine named input of the T8 bridge,
independence-checked exactly like the other three rows. -/
theorem linking_interpretation_obstruction :
    ∃ (D : DimensionForcing.Dimension)
      (R : LinkingNecessity.SpatialDualPairRealization D),
      ¬ LinkingNecessity.DeformationErasurePrinciple R.kin :=
  LinkingNecessity.dep_not_forced_by_realization_layer

/-- **Linking-interpretation forcing.**  The named principle is sufficient: in
every spatial dual-pair realization satisfying the deformation-erasure
principle, the ambient dimension is forced to `3`.  Together with the
obstruction above, the former bare "linking is required" definition is replaced
by named-input-plus-theorem. -/
theorem linking_interpretation_forcing :
    ∀ (D : DimensionForcing.Dimension)
      (R : LinkingNecessity.SpatialDualPairRealization D),
      LinkingNecessity.DeformationErasurePrinciple R.kin → D = 3 :=
  LinkingNecessity.dep_forces_D3

