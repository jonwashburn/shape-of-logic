    (hp23 : (1/2 - (1/2))^2 + (y2 - y3)^2 = v^2)
    : False := by
  have hs01 : 2*y0*y1 = u^4/2 - u^2*v^2 + u^2 + v^4/2 - 1/2 := by
    linear_combination (1)*g0 + (1)*g1 + (-1)*hp01
  have hs02 : 2*y0*y2 = u^2/2 + v^2/2 - 1/2 := by
    linear_combination (1)*g0 + (1)*g2 + (-1)*hp02
  have hs03 : 2*y0*y3 = u^2/2 + v^2/2 - 1/2 := by
    linear_combination (1)*g0 + (1)*g3 + (-1)*hp03
  have hs12 : 2*y1*y2 = u^2/2 + v^2/2 - 1/2 := by
    linear_combination (1)*g1 + (1)*g2 + (-1)*hp12
  have hs23 : 2*y2*y3 = v^2 - 1/2 := by
    linear_combination (1)*g2 + (1)*g3 + (-1)*hp23
  have hE01 : 4*(-u^4/4 + u^2*v^2/2 + u^2/2 - v^4/4 + v^2/2 - 1/4)*(-u^4/4 + u^2*v^2/2 + u^2/2 - v^4/4 + v^2/2 - 1/4) = (u^4/2 - u^2*v^2 + u^2 + v^4/2 - 1/2)^2 := by
    linear_combination (-4*y1^2)*g0 + (-4*u^2 - 2*v^2 + 4*y0*y1 + 2)*g1 + (2*u^2 + v^2 + 2*y0*y1 - 2*y1^2 - 1)*hs01
  have hE02 : 4*(-u^4/4 + u^2*v^2/2 + u^2/2 - v^4/4 + v^2/2 - 1/4)*(v^2 - 1/4) = (u^2/2 + v^2/2 - 1/2)^2 := by
    linear_combination (1 - 4*v^2)*g0 + (u^2/4 + v^2/4 - 4*y0^2 - y0*y2 - 1/4)*g2 + (u^2/2 + 2*y0*y2 + y2^2/2 - 3/8)*hs02
  have hE23 : 4*(v^2 - 1/4)*(v^2 - 1/4) = (v^2 - 1/2)^2 := by
    linear_combination (-3*v^2 - y3^2 + 3/4)*g2 + (-3*y2^2 - 2*y2*y3 - 1/4)*g3 + (2*y2*y3 + y3^2 - 1/4)*hs23
  have hF012 : (u^4/2 - u^2*v^2 + u^2 + v^4/2 - 1/2)*(u^2/2 + v^2/2 - 1/2) = 2*(u^2/2 + v^2/2 - 1/2)*(-u^4/4 + u^2*v^2/2 + u^2/2 - v^4/4 + v^2/2 - 1/4) := by
    linear_combination (-u^2 - v^2 + 2*y1*y2 + 1)*hs01 + (2*u^2 + v^2 - 4*y0*y1 - 2*y1^2 - 1)*hs12 + (2*y1^2)*hs02 + (4*y1*y2)*g1
  have hF021 : (u^2/2 + v^2/2 - 1/2)*(u^2/2 + v^2/2 - 1/2) = 2*(u^4/2 - u^2*v^2 + u^2 + v^4/2 - 1/2)*(v^2 - 1/4) := by
    linear_combination (-u^2/2 - v^2/2 + 1/2)*hs02 + (-2*y0*y2)*hs12 + (2*v^2 - 1/2)*hs01 + (4*y0*y1)*g2
  have hF203 : (u^2/2 + v^2/2 - 1/2)*(u^2/2 + v^2/2 - 1/2) = 2*(v^2 - 1/2)*(-u^4/4 + u^2*v^2/2 + u^2/2 - v^4/4 + v^2/2 - 1/4) := by
    linear_combination (-u^2/2 - v^2/2 + 1/2)*hs02 + (-2*y0*y2)*hs03 + (2*y0^2)*hs23 + (2*v^2 - 1)*g0
  have hp_zero : v^2 = 0 := by
    linear_combination (1/2)*hE01 + (1)*hE02 + (1/2)*hE23 + (2)*hF012 + (1)*hF021 + (3)*hF203
  have hpos : (0:ℝ) < v^2 := by positivity
  linarith [hp_zero, hpos]

end IndisputableMonolith.Erdos132.SlotCerts
