  have hne : ((1) : ℝ) ≠ 0 :=
    (by norm_num : ((1) : ℝ) ≠ 0)
  exact hne key

theorem sysR_748 (a b : ℝ)
    (ha0 : 0 < a) (ha1 : a < 1) (hb0 : 0 < b) (hb1 : b < 1)
    (h1 : (2) * a ^ 3 + (-2) * a ^ 2 * b + (-2) * a ^ 2 + (1) * a * b ^ 2 + (-2) * a * b + (1) * a = (0:ℝ))
    (h2 : (1) * a ^ 2 * b + (1) * a * b ^ 2 + (-4) * a * b = (0:ℝ))
    (h3 : (-3) * b ^ 2 + (1) * b = (0:ℝ)) : False := by
  have key : (1) * ((1) * a) ^ 1 * ((2) * a ^ 2 + (-2) * a + (1)) ^ 1 = 0 := by
    linear_combination ((81/158) * b + (1)) * h1 +
      ((-81/79) * a + (162/79) * b + (-85/79)) * h2 +
      ((135/158) * a * b + (-445/158) * a) * h3
  have hne : (1) * ((1) * a) ^ 1 * ((2) * a ^ 2 + (-2) * a + (1)) ^ 1 ≠ 0 :=
    (mul_ne_zero (mul_ne_zero (by norm_num : ((1) : ℝ) ≠ 0) (pow_ne_zero 1 (facNE_8 a ha0 ha1))) (pow_ne_zero 1 (facNE_0 a ha0 ha1)))
  exact hne key

theorem sysR_749 (a b : ℝ)
    (ha0 : 0 < a) (ha1 : a < 1) (hb0 : 0 < b) (hb1 : b < 1)
    (h1 : (1) * a ^ 2 + (-2) * a * b + (-2) * a + (1) * b ^ 2 + (-1) * b + (1) = (0:ℝ))
    (h2 : (1) * a ^ 2 * b + (-4) * a * b + (1) * b ^ 2 = (0:ℝ))
    (h3 : (-3) * b ^ 2 + (1) * b = (0:ℝ)) : False := by
  have key : (1) * ((1) * a + (-1)) ^ 2 = 0 := by
    linear_combination ((3/2) * b + (1)) * h1 +
      ((-3/2)) * h2 +
      ((-1) * a + (1/2) * b + (-1/2)) * h3
  have hne : (1) * ((1) * a + (-1)) ^ 2 ≠ 0 :=
    (mul_ne_zero (by norm_num : ((1) : ℝ) ≠ 0) (pow_ne_zero 2 (facNE_5 a ha0 ha1)))
  exact hne key

