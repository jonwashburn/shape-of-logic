theorem sysR_745 (a b : ℝ)
    (ha0 : 0 < a) (ha1 : a < 1) (hb0 : 0 < b) (hb1 : b < 1)
    (h1 : (1) * a ^ 2 + (-2) * a * b + (-1) * a + (1) * b ^ 2 + (-2) * b + (1) = (0:ℝ))
    (h2 : (2) * a ^ 3 + (-4) * a ^ 2 = (0:ℝ))
    (h3 : (1) * a ^ 2 + (-2) * a * b + (-2) * a + (1) * b ^ 2 + (-2) * b + (2) = (0:ℝ)) : False := by
  have key : (2) * ((1) * a + (-2)) ^ 1 * ((1) * a) ^ 2 = 0 := by
    linear_combination ((1)) * h2
  have hne : (2) * ((1) * a + (-2)) ^ 1 * ((1) * a) ^ 2 ≠ 0 :=
    (mul_ne_zero (mul_ne_zero (by norm_num : ((2) : ℝ) ≠ 0) (pow_ne_zero 1 (facNE_6 a ha0 ha1))) (pow_ne_zero 2 (facNE_8 a ha0 ha1)))
  exact hne key

theorem sysR_746 (a b : ℝ)
    (ha0 : 0 < a) (ha1 : a < 1) (hb0 : 0 < b) (hb1 : b < 1)
    (h1 : (1) * b ^ 2 + (-4) * b + (1) = (0:ℝ))
    (h2 : (1) * a ^ 3 + (-2) * a ^ 2 + (-2) * a + (1) = (0:ℝ))
    (h3 : (-4) * a + (2) = (0:ℝ)) : False := by
  have key : ((1) : ℝ) = 0 := by
    linear_combination ((-8/3)) * h2 +
