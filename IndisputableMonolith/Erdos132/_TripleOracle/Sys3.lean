  have hne : ((1) : ℝ) ≠ 0 :=
    (by norm_num : ((1) : ℝ) ≠ 0)
  exact hne key

theorem sysR_747 (a b : ℝ)
    (ha0 : 0 < a) (ha1 : a < 1) (hb0 : 0 < b) (hb1 : b < 1)
