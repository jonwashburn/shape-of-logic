      ((193/32) * a ^ 2 * b + (687/32) * a * b ^ 2 + (-2851/32) * a * b + (957/32) * a + (-47/32) * b ^ 2 + (-1) * b) * h3
  have hne : (1) * ((1) * a) ^ 1 ≠ 0 :=
    (mul_ne_zero (by norm_num : ((1) : ℝ) ≠ 0) (pow_ne_zero 1 (facNE_8 a ha0 ha1)))
  exact hne key

theorem sysR_1653 (a b : ℝ)
    (ha0 : 0 < a) (ha1 : a < 1) (hb0 : 0 < b) (hb1 : b < 1)
    (h1 : (2) * a ^ 3 + (-1) * a ^ 2 * b + (-3) * a ^ 2 + (1) * b ^ 2 + (-2) * b + (1) = (0:ℝ))
    (h2 : (1) * a ^ 2 * b + (-3) * a * b + (1) * b ^ 2 + (-2) * b + (1) = (0:ℝ))
    (h3 : (-3) * b ^ 2 + (1) * b = (0:ℝ)) : False := by
  have key : ((1) : ℝ) = 0 := by
    linear_combination ((243/11) * a * b ^ 2 + (486/55) * b ^ 3 + (-12393/220) * b ^ 2) * h1 +
      ((-486/11) * a ^ 2 * b + (243/55) * a * b ^ 2 + (5103/110) * a * b + (486/55) * b ^ 3 + (1215/44) * b ^ 2 + (2499/220) * b + (1)) * h2 +
      ((475/11) * a ^ 2 + (-6561/220) * a * b + (-4773/110) * a + (324/55) * b ^ 3 + (-2133/110) * b ^ 2 + (4919/220) * b + (-2059/220)) * h3
  have hne : ((1) : ℝ) ≠ 0 :=
    (by norm_num : ((1) : ℝ) ≠ 0)
  exact hne key

